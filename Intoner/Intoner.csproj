<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.2.5.0</Version>
    <Authors>abelfreyja</Authors>
    <PackageProjectUrl>https://github.com/Abelfreyja/Intoner</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);MA0048</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IntonerVerifyOutputPath)' != ''">
    <OutputPath>$(IntonerVerifyOutputPath)</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Update="DotNet.ReproducibleBuilds" Version="2.0.5" />
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.317" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="MessagePack" Version="3.1.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Physical" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.14" />
    <PackageReference Include="SharpDX.D3DCompiler" Version="4.2.0" />
    <PackageReference Include="SharpDX.Direct3D11" Version="4.2.0" />
    <PackageReference Include="SharpDX.DXGI" Version="4.2.0" />
    <PackageReference Include="SharpDX.Mathematics" Version="4.2.0" />
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Intoner.Api\Intoner.Api.csproj" />
    <ProjectReference Include="..\Submodules\Penumbra.Api\Penumbra.Api.csproj" />
    <ProjectReference Include="..\Submodules\Penumbra.GameData\Penumbra.GameData.csproj" />
    <ProjectReference Include="..\Submodules\Penumbra.String\Penumbra.String.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="images\intoner.png" LogicalName="intoner.png" />
    <EmbeddedResource Include="Objects\**\*.hlsl;Objects\**\*.hlsli">
      <LogicalName>$([System.String]::Copy('%(Identity)').Replace('\', '.').Replace('/', '.'))</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="SetIntonerSourceRevisionId" BeforeTargets="InitializeSourceControlInformationFromSourceControlManager;InitializeSourceControlInformation" Condition="'$(SourceRevisionId)' == ''">
    <Exec Condition="'$(Configuration)' == 'Debug' and Exists('$(MSBuildProjectDirectory)/../.git')" Command="git describe --tags --dirty --always --long" WorkingDirectory="$(MSBuildProjectDirectory)/.." ConsoleToMsBuild="true" IgnoreExitCode="true" StandardOutputImportance="Low" StandardErrorImportance="Low">
      <Output TaskParameter="ConsoleOutput" ItemName="_IntonerGitDescribeOutput" />
      <Output TaskParameter="ExitCode" PropertyName="_IntonerGitDescribeExitCode" />
    </Exec>
    <PropertyGroup Condition="'$(Configuration)' == 'Debug' and '$(_IntonerGitDescribeExitCode)' == '0' and '@(_IntonerGitDescribeOutput)' != ''">
      <SourceRevisionId>@(_IntonerGitDescribeOutput)</SourceRevisionId>
    </PropertyGroup>
    <PropertyGroup Condition="'$(SourceRevisionId)' == ''">
      <SourceRevisionId Condition="'$(Configuration)' == 'Debug'">local</SourceRevisionId>
      <SourceRevisionId Condition="'$(Configuration)' != 'Debug'">build$([System.DateTime]::UtcNow.ToString("yyyy-MM-ddTHH:mm:ss:fffZ"))</SourceRevisionId>
    </PropertyGroup>
  </Target>
  <Target Name="NotifyDalamudAfterPackaging" AfterTargets="DefaultDalamudPackagerDebug" Condition="'$(Configuration)' == 'Debug' and '$(NotifyDalamudAfterBuild)' != 'false'">
    <Touch Files="$(TargetPath)" />
  </Target>
</Project>